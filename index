<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#D32F2F"><meta name="color-scheme" content="light only"><title>Presidente</title>
<style>
:root{color-scheme:light only;--r:#D32F2F;--rd:#9B1C1C;--cd:#F5F5F5;--tx:#333;--mu:#777;--rl:#FDECEC}
*{box-sizing:border-box;margin:0;-webkit-tap-highlight-color:transparent}
body{font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--tx);background:#fff;font-size:16px;line-height:1.35}
.hdr{background:var(--r);color:#fff;padding:calc(12px + env(safe-area-inset-top)) 16px 14px;display:flex;align-items:center;gap:10px;position:sticky;top:0;z-index:5}
.hdr h1{font-size:21px;font-weight:800;letter-spacing:.5px;flex:1}.hdr .ic{color:#fff}
.hb{background:none;border:0;color:#fff;padding:4px;display:flex}
main{padding:14px;max-width:560px;margin:auto;padding-bottom:calc(30px + env(safe-area-inset-bottom))}
.ic{color:var(--r);flex:none}
h2{font-size:18px;font-weight:700;margin:18px 0 10px}
.card{background:var(--cd);border-radius:18px;padding:14px;margin-bottom:12px;box-shadow:0 1px 3px #0001}
.btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:56px;padding:12px 16px;border-radius:16px;border:2px solid var(--r);background:#fff;color:var(--r);font:700 16px Inter,system-ui,sans-serif;margin-bottom:10px;transition:.15s}
.btn.p{background:var(--r);color:#fff}.btn.p .ic{color:#fff}.btn:active{background:var(--rd);border-color:var(--rd);color:#fff}.btn:active .ic{color:#fff}
.btn.s{width:auto;min-height:40px;padding:6px 12px;font-size:14px;margin:0;border-radius:12px}.btn:disabled{opacity:.4}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}.g2 .btn{margin:0}
.stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:12px}.stats div{background:var(--cd);border-radius:16px;padding:12px 6px;text-align:center;font-size:12px;color:var(--mu)}.stats b{display:block;font-size:20px;color:var(--r);word-break:break-word}
input[type=text]{width:100%;padding:14px;border-radius:14px;border:2px solid #e3e3e3;font:16px Inter,system-ui,sans-serif;margin-bottom:10px}input:focus{outline:0;border-color:var(--r)}
select{width:100%;padding:13px;border-radius:14px;border:2px solid #e3e3e3;font:16px Inter,system-ui,sans-serif;margin-bottom:10px;background:#fff}
.row{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid #eee;border-radius:14px;padding:10px 12px;margin-bottom:8px;box-shadow:0 1px 2px #0001;min-height:54px}
.row.t{cursor:pointer}.row.sel{border-color:var(--r);background:var(--rl)}.row.low{background:var(--rl)}
.row .nm{flex:1;min-width:0;font-weight:600}.row small{display:block;color:var(--mu);font-weight:400;font-size:13px}
.pos{min-width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;background:var(--cd)}
.p1{background:#E8B531;color:#fff}.p2{background:#A5A5A5;color:#fff}.p3{background:#C8793A;color:#fff}
.pts{background:var(--rl);color:var(--r);font-weight:700;border-radius:10px;padding:5px 10px;font-size:14px;white-space:nowrap}
.rl{color:var(--r);font-size:13px;font-weight:500}
.pl{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;min-height:62px;border-radius:18px;border:2px solid #f2c4c4;background:var(--rl);color:var(--tx);font:700 19px Inter,system-ui,sans-serif;margin-bottom:10px;position:relative;transition:opacity .2s,transform .2s;max-height:90px}
.pl:active{background:var(--r);color:#fff}.pl.gone{opacity:0;transform:scale(.94)}
.pl i{position:absolute;left:14px;font-style:normal;font-size:13px;font-weight:700;color:var(--r);background:#fff;border-radius:8px;padding:2px 8px}
.in{animation:in .3s ease}@keyframes in{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:none}}
.camp{display:flex;align-items:center;gap:12px;background:#fff;border-radius:18px;padding:14px;margin-bottom:14px;box-shadow:0 2px 8px #0002}
.camp small{color:var(--mu);display:block}.camp b{font-size:26px;color:var(--r);font-weight:800;line-height:1.1}.camp div:last-child{margin-left:auto;text-align:right;font-weight:700}
.ov{position:fixed;inset:0;background:#0006;z-index:20;display:flex;align-items:flex-end}.sh{background:#fff;border-radius:22px 22px 0 0;padding:18px 16px calc(18px + env(safe-area-inset-bottom));width:100%;max-width:560px;margin:auto;max-height:85vh;overflow:auto}
.sh h3{margin-bottom:12px}
.ck{width:26px;height:26px;border-radius:8px;border:2px solid #ccc;display:flex;align-items:center;justify-content:center;flex:none}.sel .ck{background:var(--r);border-color:var(--r)}.ck .ic{color:#fff}
.pod{display:grid;gap:8px;margin-bottom:12px}.pod .card{display:flex;align-items:center;gap:12px;margin:0}.pod .c1{background:var(--r);color:#fff}.pod .c1 .ic{color:#fff}
.chips span{display:inline-flex;align-items:center;gap:3px;font-size:12px;color:var(--mu);margin-right:8px}.chips .ic{width:14px;height:14px}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:#333;color:#fff;padding:12px 18px;border-radius:14px;z-index:30;max-width:90%;text-align:center}
.warn{background:var(--rl);border-radius:14px;padding:10px 12px;font-size:14px;margin-bottom:12px}.mu{color:var(--mu);font-size:14px}.man li,.man p{margin-bottom:8px}.man ol{padding-left:20px}
.pls{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:12px}
.pl{flex-direction:column;gap:4px;min-height:0;max-height:none;width:auto;padding:12px 2px 8px;font-size:12.5px;font-weight:700;margin:0;border-radius:14px}
.pl span{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pl i{top:4px;left:4px;font-size:11px;padding:1px 6px}
.av{border-radius:50%;flex:none}
.rc{padding:6px 10px;min-height:44px;gap:8px;margin-bottom:6px}.rc .nm{font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rc .chips{display:flex;flex:none}.rc .chips span{font-size:11px;margin-right:4px;gap:1px}.rc .chips .ic{width:12px;height:12px}
.rc .pts{padding:3px 8px;font-size:13px}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style></head><body><div id=app></div><input type=file id=fi accept=".json,application/json" hidden>
<script>
const KEY='presidente_v2',LB='presidente_lb';
let db=load(),S={view:'home'};
function load(){try{const d=JSON.parse(localStorage.getItem(KEY));if(d&&d.players&&d.champs)return d}catch(e){}return{players:[],champs:[]}}
function save(){try{localStorage.setItem(KEY,JSON.stringify(db))}catch(e){alert('Não foi possível salvar. Exporte um backup agora.')}}
const $=s=>document.querySelector(s),uid=()=>Math.random().toString(36).slice(2,9)+Date.now().toString(36).slice(-4);
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const P=id=>db.players.find(p=>p.id===id),C=id=>db.champs.find(c=>c.id===id),active=()=>db.champs.find(c=>c.status==='andamento');
const nm=id=>P(id)?P(id).name:'?',fd=i=>new Date(i).toLocaleDateString('pt-BR');
const I={crown:'<path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"/><path d="M5 21h14"/>',
medal:'<path d="M7.21 15 2.66 7.14a2 2 0 0 1 .13-2.2L4.4 2.8A2 2 0 0 1 6 2h12a2 2 0 0 1 1.6.8l1.6 2.14a2 2 0 0 1 .14 2.2L16.79 15"/><path d="M11 12 5.12 2.2"/><path d="m13 12 5.88-9.8"/><path d="M8 7h8"/><circle cx="12" cy="17" r="5"/>',
chair:'<path d="M19 9V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v3"/><path d="M3 16a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V11a2 2 0 0 0-4 0z"/><path d="M5 18v2"/><path d="M19 18v2"/>',
down:'<path d="m7 6 5 5 5-5"/><path d="m7 13 5 5 5-5"/>',trash:'<path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>',
undo:'<path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/>',
trophy:'<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>',
play:'<polygon points="6 3 20 12 6 21 6 3"/>',flag:'<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><path d="M4 22v-7"/>',
plus:'<path d="M5 12h14"/><path d="M12 5v14"/>',check:'<path d="M20 6 9 17l-5-5"/>',back:'<path d="m15 18-6-6 6-6"/>',users:'<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
list:'<path d="M3 12h.01M3 18h.01M3 6h.01M8 12h13M8 18h13M8 6h13"/>',chart:'<path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/>',home:'<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .71-1.53l7-6a2 2 0 0 1 2.58 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
dl:'<path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/>',share:'<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4"/><path d="m15.4 6.5-6.8 4"/>',
swap:'<path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/>',edit:'<path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/>',
x:'<path d="M18 6 6 18"/><path d="m6 6 12 12"/>'};
const ic=(n,s=22)=>`<svg class=ic width=${s} height=${s} viewBox="0 0 24 24" fill=none stroke=currentColor stroke-width=2 stroke-linecap=round stroke-linejoin=round>${I[n]||''}</svg>`;
const SK=['#F1C9A5','#E0A97C','#C68642','#8D5524','#FFDFC4'],HR=['#2b1b12','#5a3825','#b5651d','#111','#d4a24c','#7a1f1f'];
function avt(id,z=36){let h=0;for(const ch of id)h=(h*31+ch.charCodeAt(0))>>>0;const sk=SK[h%5],hr=HR[(h>>3)%6],st=(h>>6)%3;
 return`<svg class=av width=${z} height=${z} viewBox="0 0 40 40"><circle cx=20 cy=20 r=20 fill="#F8D7D7"/><path d="M6 40c0-9 6-13 14-13s14 4 14 13z" fill="#D32F2F"/><circle cx=20 cy=17 r=8 fill="${sk}"/>${st==0?`<path d="M12 16a8 8 0 0 1 16 0c-3-3-10-4-16 0z" fill="${hr}"/>`:st==1?`<path d="M11.5 18a8.5 8.5 0 0 1 17 0v8h-3v-8h-11v8h-3z" fill="${hr}"/>`:`<path d="M12 15a8 8 0 0 1 16 0c-2-5-14-5-16 0z" fill="${hr}"/>`}</svg>`}
const NAMES=['Sushi','Temaki','Yakisoba','Wasabi','Sashimi','Tempurá','Gyoza','Udon','Ramen','Missô','Takoyaki','Onigiri','Katsu','Hot Roll','Edamame','Mochi','Dorayaki','Teriyaki','Shoyu','Nigiri','Uramaki','Okonomiyaki'];
function sortName(){const used=db.champs.map(c=>c.name),f=NAMES.filter(n=>!used.includes('Campeonato '+n));if(f.length)return'Campeonato '+f[Math.random()*f.length|0];return'Campeonato '+NAMES[Math.random()*NAMES.length|0]+' '+(db.champs.length+1)}
function role(p,n){return p==1?['pres','Presidente','crown']:p==n?['lixao','Lixão','trash']:(p==n-1&&n>=4)?['lixinho','Lixinho','down']:p==2?['vice','Vice-presidente','medal']:p==3?['sup','Suplente','chair']:['mid',p+'ª posição','']}
const pts=(p,n)=>n-p+1,pc=p=>p<4?' p'+p:'';
function stand(c){const m={},g=id=>m[id]||(m[id]={id,pts:0,r:0,pres:0,vice:0,lixinho:0,lixao:0});
 c.rounds.forEach(r=>{const n=r.order.length;r.order.forEach((id,i)=>{const s=g(id),k=role(i+1,n)[0];s.pts+=pts(i+1,n);s.r++;if(s[k]!==undefined)s[k]++})});
 return Object.values(m).sort((a,b)=>b.pts-a.pts||b.pres-a.pres||a.lixao-b.lixao||nm(a.id).localeCompare(nm(b.id)))}
const fin=()=>db.champs.filter(c=>c.status==='finalizado');
function gRank(y){const m={};fin().filter(c=>y=='all'||new Date(c.date).getFullYear()==y).forEach(c=>stand(c).forEach(s=>{const o=m[s.id]||(m[s.id]={id:s.id,pts:0,n:0,r:0});o.pts+=s.pts;o.n++;o.r+=s.r}));return Object.values(m).sort((a,b)=>b.pts-a.pts||b.n-a.n)}
function toast(t){const e=document.createElement('div');e.className='toast';e.textContent=t;document.body.appendChild(e);setTimeout(()=>e.remove(),2600)}
function go(v,x){S=Object.assign({view:v},x||{});render();scrollTo(0,0)}
const chips=s=>`<div class=chips>${[['pres','crown'],['vice','medal'],['lixinho','down'],['lixao','trash']].map(([k,i])=>`<span>${ic(i,14)}${s[k]}×</span>`).join('')}</div>`;
function lrow(s,i,extra){return`<div class="row ${i==0?'sel':''}"><span class="pos${pc(i+1)}">${i+1}º</span><div class=nm>${esc(nm(s.id))}<small>${extra}</small></div><span class=pts>${s.pts} pts</span></div>`}
function inp(ph){return`<input type=text id=np placeholder="${ph}" maxlength=30 autocomplete=off><button class="btn p" data-a=addp>${ic('plus')} Adicionar jogador</button>`}

function render(){
 const v=S.view;let t='PRESIDENTE',h='',m='';
 if(v=='home'){const a=active(),L=gRank('all'),lc=fin().sort((a,b)=>(b.finishedAt||'').localeCompare(a.finishedAt||''))[0],tr=db.champs.reduce((s,c)=>s+c.rounds.length,0),lb=localStorage.getItem(LB);
  h=`<h2 style="margin-top:0">Ranking geral</h2>${L.length?L.slice(0,5).map((s,i)=>`<div class="row ${i==0?'sel':''}"><span class="pos${pc(i+1)}">${i+1}º</span><div class=nm>${esc(nm(s.id))}<small>${s.n} campeonato${s.n>1?'s':''}</small></div><span class=pts>${s.pts} pts</span></div>`).join(''):'<div class="card mu">O ranking aparece quando o primeiro campeonato for finalizado.</div>'}
  <div class=stats style="margin-top:12px"><div><b>${fin().length}</b>campeonatos</div><div><b>${tr}</b>rodadas</div><div><b>${lc?esc(nm(stand(lc)[0].id)):'–'}</b>último campeão</div></div>
  ${a?`<button class="btn p" data-a=cont>${ic('play')} Continuar Campeonato</button>`:''}<button class="btn ${a?'':'p'}" data-a=newc>${ic('plus')} Novo Campeonato</button>
  <div class=g2><button class=btn data-a=rank>${ic('chart')} Ranking</button><button class=btn data-a=hist>${ic('trophy')} Histórico</button><button class=btn data-a=pl>${ic('users')} Jogadores</button><button class=btn data-a=bkp>${ic('dl')} Backup</button></div>
  ${lb?'':'<div class=warn style="margin-top:12px">Ainda não há backup. Exporte regularmente: limpar os dados do navegador apaga os registros.</div>'}`}
 else if(v=='newc'){t='Novo campeonato';const ps=db.players.filter(p=>p.active!==false);
  h=`<h2 style="margin-top:0">Quem vai jogar hoje?</h2>${inp('Nome do novo jogador')}<div class=g2 style="margin-bottom:12px"><button class="btn s" data-a=selall>Selecionar todos</button><button class="btn s" data-a=selnone>Limpar seleção</button></div>
  ${ps.map(p=>`<div class="row t ${S.sel.includes(p.id)?'sel':''}" data-a=tsel data-id="${p.id}"><span class=ck>${S.sel.includes(p.id)?ic('check',16):''}</span><div class=nm>${esc(p.name)}</div></div>`).join('')}
  <button class="btn p" style="margin-top:12px" data-a=start>${ic('play')} Iniciar Campeonato (${S.sel.length})</button>`}
 else if(v=='round'){const c=C(S.cid),cu=c.cur,n=cu.base.length,av=cu.base.filter(i=>!cu.order.includes(i)),lr=c.rounds[c.rounds.length-1],pp={};(lr?lr.order:[]).forEach((id,i)=>pp[id]=i+1);const done=!av.length&&n>=2;
  const ub=`<button class=btn data-a=undo ${cu.undo.length?'':'disabled'}>${ic('undo')} Desfazer último</button>`;
  h=`<div class=camp>${ic('trophy',40)}<div><small>Campeonato</small><b>${esc(c.name.replace('Campeonato ',''))}</b></div><div><small>${fd(c.date)}</small>Rodada ${c.rounds.length+1}</div></div>
  ${av.length?`<p style="font-weight:600;margin-bottom:10px;font-size:15px">Toque no jogador conforme a ordem que terminar</p><div class=pls>${av.map(id=>`<button class=pl data-a=pick data-id="${id}">${pp[id]?`<i>${pp[id]}º</i>`:''}${avt(id,40)}<span>${esc(nm(id))}</span></button>`).join('')}</div>`:`<p class=mu style="margin-bottom:8px">${n<2?'Selecione ao menos 2 jogadores.':'Todos classificados.'}</p>`}
  <h2 style="margin-top:6px">Classificação da rodada <span class=mu style="font-weight:400;float:right;margin-top:3px">${cu.order.length} de ${n}</span></h2>
  ${cu.order.length?cu.order.map((id,i)=>{const r=role(i+1,n);return`<div class="row rc ${r[0]=='lixao'||r[0]=='lixinho'?'low':''} ${S.newId==id?'in':''}"><span class="pos${pc(i+1)}">${i+1}º</span>${r[2]?ic(r[2],20):'<span style="width:20px;flex:none"></span>'}${avt(id,30)}<div class=nm>${esc(nm(id))}</div><span class=rl style="white-space:nowrap;font-size:12px">${r[1]}</span><span class=pts>${pts(i+1,n)} pts</span></div>`}).join(''):'<div class="card mu">Ainda ninguém classificado.</div>'}
  <div style="margin-top:14px">${cu.order.length||cu.undo.length?(done?`<div class=g2>${ub}<button class="btn p" data-a=nextr>${ic('play')} Nova Rodada</button></div><button class=btn style="margin-top:10px" data-a=final>${ic('flag')} Finalizar Campeonato</button>`:ub):''}
  ${!cu.order.length?`<button class=btn data-a=part>${ic('users')} Quem joga nesta rodada</button>${c.rounds.length?`<button class=btn data-a=editprev>${ic('edit')} Editar rodada anterior</button>`:''}`:''}</div>`}
 else if(v=='final'){const c=C(S.cid),st=stand(c);t='Resultado';
  h=`<div class=card style="text-align:center"><b style="font-size:20px">${esc(c.name)}</b><br><span class=mu>${fd(c.date)} · ${c.rounds.length} rodadas</span></div>
  <div class=pod>${st.slice(0,3).map((s,i)=>`<div class="card ${i==0?'c1':''}">${ic(['trophy','medal','medal'][i],30)}<div style="flex:1"><small>${['Campeão','2º lugar','3º lugar'][i]}</small><br><b style="font-size:19px">${esc(nm(s.id))}</b></div><b style="font-size:20px">${s.pts} pts</b></div>`).join('')}</div>
  <h2>Pontuação e cargos</h2>${st.map((s,i)=>`<div class="row rc ${i==0?'sel':''}"><span class="pos${pc(i+1)}">${i+1}º</span>${avt(s.id,26)}<div class=nm>${esc(nm(s.id))}</div>${chips(s)}<span class=pts>${s.pts}</span></div>`).join('')}
  <p class=mu style="font-size:12px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:14px">${ic('crown',13)} Presidente ${ic('medal',13)} Vice ${ic('down',13)} Lixinho ${ic('trash',13)} Lixão</p>
  <button class="btn p" data-a=share>${ic('share')} Compartilhar no WhatsApp</button><button class=btn data-a=hist>${ic('list')} Ver Histórico</button><button class=btn data-a=newc>${ic('plus')} Novo Campeonato</button><button class=btn data-a=exp>${ic('dl')} Exportar Backup</button>`} else if(v=='hist'){t='Histórico';const f=fin().reverse();
  h=f.length?f.map(c=>`<button class=btn data-a=openc data-id="${c.id}" style="justify-content:space-between;text-align:left"><span>${esc(c.name)}<br><small style="font-weight:400;color:var(--mu)">${fd(c.date)} · ${c.rounds.length} rodadas</small></span><span>${esc(nm(stand(c)[0].id))}</span></button>`).join(''):'<div class="card mu">Nenhum campeonato finalizado.</div>'}
 else if(v=='rank'){t='Ranking geral';const ys=[...new Set(fin().map(c=>new Date(c.date).getFullYear()))].sort().reverse(),L=gRank(S.year);
  h=`<select data-a=year><option value=all>Todos os anos</option>${ys.map(y=>`<option ${S.year==y?'selected':''}>${y}</option>`).join('')}</select>${L.length?L.map((s,i)=>`<div class="row ${i==0?'sel':''}"><span class="pos${pc(i+1)}">${i+1}º</span><div class=nm>${esc(nm(s.id))}<small>${s.n} campeonatos · ${s.r} rodadas</small></div><span class=pts>${s.pts} pts</span></div>`).join(''):'<div class="card mu">Sem campeonatos finalizados neste período.</div>'}`}
 else if(v=='pl'){t='Jogadores';
  h=inp('Nome do jogador')+(db.players.length?'':'<p class=mu>Cadastre os jogadores uma única vez.</p>')+db.players.map(p=>`<div class=row style="${p.active===false?'opacity:.55':''}"><div class=nm>${esc(p.name)}<small>${p.active===false?'Inativo':'Ativo'}</small></div><button class="btn s" data-a=pinfo data-id="${p.id}">Detalhes</button></div>`).join('')}
 else if(v=='pinfo'){const p=P(S.pid);t=esc(p.name);const z={pres:0,vice:0,lixinho:0,lixao:0,pts:0,r:0,t:0},ls=[];
  fin().forEach(c=>{const st=stand(c),i=st.findIndex(s=>s.id==p.id);if(i<0)return;const s=st[i];['pres','vice','lixinho','lixao','pts','r'].forEach(k=>z[k]+=s[k]);if(i==0)z.t++;ls.push(`<div class=row><div class=nm>${esc(c.name)}<small>${fd(c.date)}</small></div><span class="pos${pc(i+1)}">${i+1}º</span><span class=pts>${s.pts}</span></div>`)});
  h=`<div class=stats><div><b>${ls.length}</b>campeonatos</div><div><b>${z.t}</b>títulos</div><div><b>${z.pts}</b>pontos</div></div><div class=card>${chips(z)}<span class=mu>${z.r} rodadas disputadas</span></div>
  <button class=btn data-a=ren data-id="${p.id}">${ic('edit')} Corrigir nome</button><button class=btn data-a=tact data-id="${p.id}">${p.active===false?'Reativar jogador':'Desativar jogador'}</button>
  ${used(p.id)?'':`<button class=btn data-a=delp data-id="${p.id}">${ic('trash')} Excluir jogador</button>`}<h2>Participações</h2>${ls.join('')||'<p class=mu>Sem campeonatos finalizados.</p>'}`}
 else if(v=='bkp'){t='Backup';h=`<div class=warn>Os dados ficam só neste navegador. Para trocar de celular: exporte, envie o <b>index.html</b> e o <b>.json</b>, e importe no outro aparelho. Limpar os dados do navegador apaga tudo.</div><button class="btn p" data-a=exp>${ic('dl')} Exportar backup (.json)</button><button class=btn data-a=imp>${ic('dl')} Importar backup</button><p class=mu>Último backup: ${localStorage.getItem(LB)?fd(localStorage.getItem(LB)):'nunca'}</p>`}
 if(S.part){m=`<div class=ov><div class=sh><h3>Quem joga nesta rodada?</h3>${db.players.filter(p=>p.active!==false||S.part.includes(p.id)).map(p=>`<div class="row t ${S.part.includes(p.id)?'sel':''}" data-a=tpart data-id="${p.id}"><span class=ck>${S.part.includes(p.id)?ic('check',16):''}</span><div class=nm>${esc(p.name)}</div></div>`).join('')}<button class="btn p" data-a=okpart>Aplicar</button><button class=btn data-a=cancel>Cancelar</button></div></div>`}
 $('#app').innerHTML=`<div class=hdr>${v!='home'?`<button class=hb data-a=back>${ic('back',26)}</button>`:ic('crown',28)}<h1>${t}</h1>${v!='home'?`<button class=hb data-a=home>${ic('home')}</button>`:''}</div><main>${h}</main>${m}`;S.newId=null}
function used(id){return db.champs.some(c=>c.rounds.some(r=>r.order.includes(id))||(c.cur&&c.cur.base.includes(id)))}
const cur=()=>C(S.cid).cur;
function snap(){const u=cur().undo;u.push([...cur().order]);if(u.length>60)u.shift()}
function addPlayer(){const n=($('#np').value||'').trim();if(!n)return toast('Digite o nome.');if(db.players.some(p=>p.name.toLowerCase()==n.toLowerCase()))return toast('Esse jogador já existe.');
 const p={id:uid(),name:n,active:true};db.players.push(p);save();if(S.sel)S.sel.push(p.id);render();toast('Jogador adicionado.')}
const A={
 back:()=>go(S.view=='pinfo'?'pl':'home'),home:()=>go('home'),addp:addPlayer,
 newc:()=>active()?toast('Há um campeonato em andamento. Continue ou finalize.'):go('newc',{sel:db.players.filter(p=>p.active!==false).map(p=>p.id)}),
 cont:()=>go('round',{cid:active().id}),rank:()=>go('rank',{year:'all'}),hist:()=>go('hist'),pl:()=>go('pl'),bkp:()=>go('bkp'),imp:()=>$('#fi').click(),exp:()=>exportData(),
 selall:()=>{S.sel=db.players.filter(p=>p.active!==false).map(p=>p.id);render()},selnone:()=>{S.sel=[];render()},
 tsel:e=>{const i=S.sel.indexOf(e.dataset.id);i<0?S.sel.push(e.dataset.id):S.sel.splice(i,1);render()},
 start:()=>{if(S.sel.length<2)return toast('Selecione ao menos 2 jogadores.');const base=db.players.filter(p=>S.sel.includes(p.id)).map(p=>p.id),
  c={id:uid(),name:sortName(),date:new Date().toISOString(),status:'andamento',rounds:[],cur:{base,order:[],undo:[]}};db.champs.push(c);save();go('round',{cid:c.id})},
 pick:e=>{if(e.classList.contains('gone'))return;e.classList.add('gone');const id=e.dataset.id;setTimeout(()=>{snap();cur().order.push(id);S.newId=id;save();render()},200)},
 cancel:()=>{S.menu=null;S.swap=null;S.part=null;render()},
 undo:()=>{const u=cur().undo;if(u.length){cur().order=u.pop();save();render()}},
 nextr:()=>{const c=C(S.cid);c.rounds.push({order:[...c.cur.order]});c.cur={base:[...c.cur.order],order:[],undo:[]};save();render();scrollTo(0,0);toast('Rodada salva.')},
 final:()=>{if(!confirm('Finalizar o campeonato e somar todos os pontos?'))return;const c=C(S.cid);c.rounds.push({order:[...c.cur.order]});delete c.cur;c.status='finalizado';c.finishedAt=new Date().toISOString();save();go('final',{cid:c.id})},
 part:()=>{S.part=[...cur().base];render()},tpart:e=>{const i=S.part.indexOf(e.dataset.id);i<0?S.part.push(e.dataset.id):S.part.splice(i,1);render()},
 okpart:()=>{if(S.part.length<2)return toast('Selecione ao menos 2 jogadores.');const cu=cur(),k=cu.base.filter(i=>S.part.includes(i));db.players.forEach(p=>{if(S.part.includes(p.id)&&!k.includes(p.id))k.push(p.id)});cu.base=k;S.part=null;save();render()},
 editprev:()=>{if(!confirm('Reabrir a rodada anterior para corrigir? Os pontos serão recalculados.'))return;const c=C(S.cid),r=c.rounds.pop();c.cur={base:[...r.order],order:[...r.order],undo:r.order.map((_,i)=>r.order.slice(0,i))};save();render();scrollTo(0,0)},
 openc:e=>go('final',{cid:e.dataset.id}),share:()=>shareImg(C(S.cid)),
 pinfo:e=>go('pinfo',{pid:e.dataset.id}),
 ren:e=>{const p=P(e.dataset.id),n=(prompt('Novo nome:',p.name)||'').trim();if(!n)return;if(db.players.some(x=>x.id!=p.id&&x.name.toLowerCase()==n.toLowerCase()))return toast('Esse nome já existe.');p.name=n;save();render()},
 tact:e=>{const p=P(e.dataset.id);p.active=p.active===false;save();render()},
 delp:e=>{if(used(e.dataset.id))return;if(!confirm('Excluir este jogador?'))return;db.players=db.players.filter(p=>p.id!=e.dataset.id);save();go('pl')}
};
document.addEventListener('click',e=>{const el=e.target.closest('[data-a]');if(el&&el.tagName!='SELECT'&&A[el.dataset.a])A[el.dataset.a](el)});
document.addEventListener('change',e=>{if(e.target.dataset.a=='year'){S.year=e.target.value;render()}
 if(e.target.id=='fi'){const f=e.target.files[0];if(f)importFile(f);e.target.value=''}});
document.addEventListener('keydown',e=>{if(e.key=='Enter'&&e.target.id=='np')addPlayer()});
function dl(b,n){const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=n;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),4000)}
function exportData(){const now=new Date().toISOString();dl(new Blob([JSON.stringify({app:'presidente-placar',version:2,exportedAt:now,data:db},null,1)],{type:'application/json'}),'presidente-backup-'+now.slice(0,10)+'.json');localStorage.setItem(LB,now);toast('Backup baixado. Envie o arquivo .json.')}
function validate(d){if(!d||d.app!=='presidente-placar'||!d.data)throw'Este arquivo não é um backup do Presidente.';const x=d.data;if(d.version!=2||!Array.isArray(x.players)||!Array.isArray(x.champs))throw'Backup de versão incompatível ou estrutura inválida.';
 const ids=new Set(x.players.map(p=>{if(!p.id||!p.name)throw'Jogador inválido no arquivo.';return p.id})),ok=a=>Array.isArray(a)&&a.every(i=>ids.has(i));
 x.champs.forEach(c=>{if(!c.id||!c.name||!c.date||!Array.isArray(c.rounds))throw'Campeonato inválido: '+(c.name||'?');if(c.rounds.some(r=>!ok(r.order)))throw'Rodada com jogador inexistente em '+c.name;if(c.status=='andamento'&&(!c.cur||!ok(c.cur.base)||!ok(c.cur.order)||!Array.isArray(c.cur.undo)))throw'Rodada em andamento inválida em '+c.name});return x}
function importFile(f){const r=new FileReader();r.onload=()=>{try{const x=validate(JSON.parse(r.result));if(!confirm(`Importar ${x.players.length} jogadores e ${x.champs.length} campeonatos?\n\nISTO SUBSTITUI os dados deste aparelho.`))return;db={players:x.players,champs:x.champs};save();toast('Dados importados.');go('home')}catch(e){alert('Erro na importação: '+(typeof e=='string'?e:'o arquivo não é um JSON válido.'))}};r.readAsText(f)}
function shareImg(c){const st=stand(c),mx=Math.max(...st.map(s=>s.pres)),cv=document.createElement('canvas'),H=Math.max(1200,420+st.length*100+120),f='Inter,system-ui,sans-serif';cv.width=1080;cv.height=H;const g=cv.getContext('2d');
 const crown=(x,y,z)=>{g.save();g.translate(x,y);g.scale(z/24,z/24);g.strokeStyle='#D32F2F';g.lineWidth=2;g.lineCap='round';g.lineJoin='round';g.stroke(new Path2D('M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z'));g.stroke(new Path2D('M5 21h14'));g.restore()};
 g.fillStyle='#fff';g.fillRect(0,0,1080,H);g.fillStyle='#D32F2F';g.fillRect(0,0,1080,210);g.fillStyle='#fff';g.textAlign='center';g.font='bold 38px '+f;g.fillText('PRESIDENTE',540,75);g.font='bold 70px '+f;g.fillText(c.name,540,160);
 g.fillStyle='#777';g.font='32px '+f;g.fillText(fd(c.date)+' · '+c.rounds.length+' rodadas',540,270);
 st.forEach((s,i)=>{const y=310+i*100;g.fillStyle=i==0?'#FDECEC':i%2?'#fff':'#F5F5F5';g.fillRect(50,y,980,88);g.textAlign='left';g.fillStyle=i==0?'#D32F2F':'#333';g.font='bold 44px '+f;g.fillText((i+1)+'º',80,y+60);g.fillText(nm(s.id),190,y+60);
  if(mx>0&&s.pres==mx)crown(190+g.measureText(nm(s.id)).width+18,y+22,44);g.textAlign='right';g.fillText(s.pts+' pts',1000,y+60)});
 const y=310+st.length*100+40,big=st.filter(s=>s.pres==mx&&mx>0).map(s=>nm(s.id)).join(', ');
 if(big){crown(60,y-30,44);g.textAlign='left';g.fillStyle='#333';g.font='30px '+f;g.fillText('Maior presidente: '+big+' ('+mx+'×)',120,y+4)}
 const txt=c.name+' – campeão: '+nm(st[0].id)+' ('+st[0].pts+' pts)';
 cv.toBlob(async b=>{const file=new File([b],'presidente-pontuacao.png',{type:'image/png'});
  if(navigator.canShare&&navigator.canShare({files:[file]})){try{await navigator.share({files:[file],text:txt})}catch(e){}}
  else{dl(b,file.name);toast('Imagem baixada. Abrindo o WhatsApp…');setTimeout(()=>window.open('https://wa.me/?text='+encodeURIComponent(txt),'_blank'),900)}},'image/png')}
render();
</script></body></html>
